# ========================================================
# MORPHEUS / G38 — ENVIRONMENT CONFIGURATION (TEMPLATE)
# ========================================================

# Django Core
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL + pgvector in Docker / Production)
# Leave empty to automatically fallback to local SQLite during offline development
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/your_db_name

# Google Gemini API Configuration (Official google-genai SDK)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite

# Vector Embeddings Service (Sentence Transformers - 384 dim)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.25

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
MAX_UPLOAD_SIZE=26214400

# JWT Token Expirations
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Email Service (Optional SMTP Provider)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_smtp_user
EMAIL_HOST_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=Morpheus Campus Assistant <noreply@morpheus.campus.edu>

# Testmail.app Integration Testing Configuration
TESTMAIL_API_KEY=your_testmail_api_key_here
TESTMAIL_NAMESPACE=your_testmail_namespace_here
TESTMAIL_API_URL=https://api.testmail.app/api/json
RUN_TESTMAIL_INTEGRATION=0

