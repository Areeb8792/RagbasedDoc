# ========================================================
# MORPHEUS — ROOT GITIGNORE CONFIGURATION (SECURITY FIRST)
# ========================================================

# 1. Environment Files & Credentials (CRITICAL)
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.cert
*.crt
id_rsa*

# 2. Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# 3. Django Databases & Generated Assets
*.log
logs/
local_settings.py
*.sqlite3
*.sqlite3-journal
*.db
staticfiles/
backend/staticfiles/

# 4. User Uploaded Documents & Media Storage (PRIVATE)
media/*
!media/.gitkeep
backend/media/*
!backend/media/.gitkeep
uploads/
backend/uploads/

# 5. Vector Store & Embedding Local Caches
chroma_db/
faiss_index/
*.index

# 6. Node.js & Frontend Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local

# 7. IDE & Editor Artifacts
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# 8. Local Prompt Dumps & Temporary Files
user_prompt_morpheus.txt
*.tmp
*.bak
